if(NOT EXISTS "${IMAGE}" OR NOT EXISTS "${EXPECTED}")
    message(FATAL_ERROR "Shared library or linked test executable is missing")
endif()
if(EXPECTED MATCHES "\\.(a|lib)$")
    message(FATAL_ERROR "SDK target is still an archive, not a shared library: ${EXPECTED}")
endif()
file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${IMAGE}" RESOLVED_DEPENDENCIES_VAR _resolved
    UNRESOLVED_DEPENDENCIES_VAR _unresolved CONFLICTING_DEPENDENCIES_PREFIX _conflicts)
if(_unresolved)
    message(FATAL_ERROR "Executable has unresolved runtime libraries: ${_unresolved}")
endif()
foreach(_name IN LISTS _conflicts_FILENAMES)
    unset(_first_hash)
    foreach(_candidate IN LISTS _conflicts_${_name})
        file(SHA256 "${_candidate}" _hash)
        if(DEFINED _first_hash AND NOT _first_hash STREQUAL _hash)
            message(FATAL_ERROR "Different runtime libraries share the name ${_name}: ${_conflicts_${_name}}")
        endif()
        set(_first_hash "${_hash}")
        list(APPEND _resolved "${_candidate}")
    endforeach()
endforeach()
file(REAL_PATH "${EXPECTED}" _wanted)
file(REAL_PATH "${NATIVE_PROVIDER}" _native_wanted)
file(REAL_PATH "${QT_PROVIDER}" _qt_wanted)
set(_found FALSE)
set(_found_native FALSE)
set(_found_qt FALSE)
foreach(_path IN LISTS _resolved)
    file(REAL_PATH "${_path}" _actual)
    if(_actual STREQUAL _wanted)
        set(_found TRUE)
    endif()
    if(_actual STREQUAL _native_wanted)
        set(_found_native TRUE)
    endif()
    if(_actual STREQUAL _qt_wanted)
        set(_found_qt TRUE)
    endif()
    get_filename_component(_name "${_path}" NAME)
    if(CMAKE_HOST_APPLE AND _name MATCHES "^libiiFileProvider\\.[0-9].*\\.dylib$"
            AND NOT _actual STREQUAL _qt_wanted)
        message(FATAL_ERROR "An incompatible Qt provider ABI is present: ${_path}")
    endif()
endforeach()
if(NOT _found)
    message(FATAL_ERROR "Executable does not dynamically link the SDK library: ${EXPECTED}; ${_unresolved}")
endif()
if(NOT _found_native OR NOT _found_qt)
    message(FATAL_ERROR "Executable did not resolve the selected Native and Qt providers: ${NATIVE_PROVIDER}; ${QT_PROVIDER}")
endif()
