@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(iiFileProvider 0.7.1 CONFIG HINTS "$ENV{IIFILEPROVIDER_PREFIX}" "$ENV{HOME}/.local/SDK/iiFileProvider")






find_dependency(Qt6 6.8.3 EXACT COMPONENTS Core Sql Network)
find_dependency(iiFileProvider 0.7.1 CONFIG)
find_dependency(iiSocietyContainer 0.16.1 CONFIG)
find_dependency(iiSharedCanvas 0.31.1 EXACT CONFIG COMPONENTS Core HINTS "${CMAKE_CURRENT_LIST_DIR}/../../../../iiSharedCanvas" "$ENV{HOME}/.local/SDK/iiSharedCanvas")
find_dependency(iiAcountManager 0.2.8 CONFIG)
find_dependency(iiSocietyMonitor 0.1 CONFIG HINTS "$ENV{HOME}/.local/SDK/iiSocietyMonitor")
find_dependency(iiSocietySync 0.8.3 CONFIG)
if(APPLE)
    find_dependency(Qt6 6.8.3 EXACT COMPONENTS Concurrent)
endif()
if(NOT IOS AND NOT ANDROID)
    find_dependency(OpenSSL 3 COMPONENTS Crypto)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiSocietyHelperTargets.cmake")
check_required_components(iiSocietyHelper)
