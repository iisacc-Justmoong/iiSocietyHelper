@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(_helper_prefix "${PACKAGE_PREFIX_DIR}")
set(_helper_components "${iiSocietyHelper_FIND_COMPONENTS}")
if(NOT _helper_components)
    set(_helper_components Core)
endif()
foreach(_component IN LISTS _helper_components)
    if(NOT _component MATCHES "^(Core|Monitoring|GenerationHost)$")
        set(iiSocietyHelper_${_component}_FOUND FALSE)
    endif()
endforeach()
# Core consumes Monitoring; the native component never imports Core in return.
find_dependency(Threads)
find_dependency(iiSDKCore 0.11 CONFIG)
find_dependency(iiFileProviderCoreIO 0.1.1 CONFIG)
find_dependency(iiSocietyContainer 0.16 CONFIG COMPONENTS FileTree)
if(NOT TARGET iiSocietyHelper::Monitoring)
    include("${CMAKE_CURRENT_LIST_DIR}/iiSocietyHelperMonitoringTargets.cmake")
endif()
set(iiSocietyHelper_Monitoring_FOUND TRUE)
if("Core" IN_LIST _helper_components OR "GenerationHost" IN_LIST _helper_components)
    if(NOT @IISOCIETYHELPER_BUILD_CORE@)
        set(iiSocietyHelper_FOUND FALSE)
        set(iiSocietyHelper_NOT_FOUND_MESSAGE "This installation contains only native Monitoring")
        return()
    endif()
    find_dependency(Qt6 6.8.3 EXACT COMPONENTS Core Gui Sql Network)
    find_dependency(iiFileProvider 0.7.1 CONFIG)
    find_dependency(iiFileProviderTemporary CONFIG)
    find_dependency(iiSocietyContainer 0.16.1 CONFIG)
    find_dependency(iiSharedCanvas 0.31.3 EXACT CONFIG COMPONENTS Core)
    find_dependency(iiAcountManager 0.2.8 CONFIG)
    find_dependency(iiServerHost 0.6.0 CONFIG)
    if(@IISOCIETYHELPER_WITH_BLE@)
        find_dependency(Qt6 6.8.3 EXACT COMPONENTS Bluetooth)
    endif()
    if(APPLE)
        find_dependency(Qt6 6.8.3 EXACT COMPONENTS Concurrent)
    endif()
    if(NOT IOS AND NOT ANDROID)
        find_dependency(OpenSSL 3 COMPONENTS Crypto)
    endif()
    if(NOT TARGET iiSocietyHelper::iiSocietyHelper)
        include("${CMAKE_CURRENT_LIST_DIR}/iiSocietyHelperTargets.cmake")
    endif()
    set(iiSocietyHelper_Core_FOUND TRUE)
endif()
if("GenerationHost" IN_LIST _helper_components)
    if(NOT @IISOCIETYHELPER_BUILD_GENERATION_HOST@)
        set(iiSocietyHelper_GenerationHost_FOUND FALSE)
    else()
        find_dependency(iiLocalDiffusion CONFIG)
        find_dependency(Qt6 6.8.3 EXACT COMPONENTS Gui Concurrent)
        if(NOT TARGET iiSocietyHelper::GenerationHost)
            include("${CMAKE_CURRENT_LIST_DIR}/iiSocietyHelperGenerationHostTargets.cmake")
        endif()
        set(iiSocietyHelper_GenerationHost_FOUND TRUE)
    endif()
endif()
if(APPLE AND NOT IOS AND TARGET WrapOpenGL::WrapOpenGL)
    get_target_property(_helper_gl WrapOpenGL::WrapOpenGL INTERFACE_LINK_LIBRARIES)
    if(_helper_gl)
        list(FILTER _helper_gl EXCLUDE REGEX "AGL")
        set_property(TARGET WrapOpenGL::WrapOpenGL PROPERTY INTERFACE_LINK_LIBRARIES "${_helper_gl}")
    endif()
endif()
set(PACKAGE_PREFIX_DIR "${_helper_prefix}")
check_required_components(iiSocietyHelper)
