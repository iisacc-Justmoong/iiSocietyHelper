# Do not compile one FileDevice layout and link a different provider ABI.
function(iisociety_check_provider_header_files native_header qt_header)
    if(EXISTS "${native_header}" AND EXISTS "${qt_header}")
        file(SHA256 "${native_header}" native_hash)
        file(SHA256 "${qt_header}" qt_hash)
        if(NOT native_hash STREQUAL qt_hash)
            message(FATAL_ERROR
                "The selected iiFileProvider Native and Qt packages expose different iiFileProviderDevice.h files. "
                "Use packages from the same SDK build: ${native_header}; ${qt_header}")
        endif()
    endif()
endfunction()

# An SDK installation may contain a private copy of the provider alongside a
# dependent library. Do not allow the loader to choose between different
# binaries with the same runtime name.
function(iisociety_check_provider_binary_files selected candidate)
    if(EXISTS "${selected}" AND EXISTS "${candidate}")
        file(SHA256 "${selected}" selected_hash)
        file(SHA256 "${candidate}" candidate_hash)
        if(NOT selected_hash STREQUAL candidate_hash)
            message(FATAL_ERROR
                "The selected provider and a dependent package contain different runtime binaries: "
                "${selected}; ${candidate}. Rebuild or restage the dependent package with the selected provider.")
        endif()
    endif()
endfunction()

function(iisociety_imported_runtime target configuration out_path out_name)
    set(${out_path} "" PARENT_SCOPE)
    set(${out_name} "" PARENT_SCOPE)
    if(NOT TARGET "${target}")
        return()
    endif()
    get_target_property(imported "${target}" IMPORTED)
    get_target_property(kind "${target}" TYPE)
    if(NOT imported OR NOT kind STREQUAL "SHARED_LIBRARY")
        return()
    endif()
    string(TOUPPER "${configuration}" upper_config)
    get_target_property(mapped "${target}" "MAP_IMPORTED_CONFIG_${upper_config}")
    get_target_property(available "${target}" IMPORTED_CONFIGURATIONS)
    set(choices ${mapped} ${upper_config} NOCONFIG ${available})
    list(REMOVE_DUPLICATES choices)
    foreach(config IN LISTS choices)
        if(NOT config OR config MATCHES "-NOTFOUND$")
            continue()
        endif()
        string(TOUPPER "${config}" config)
        get_target_property(path "${target}" "IMPORTED_LOCATION_${config}")
        if(path AND EXISTS "${path}")
            get_target_property(soname "${target}" "IMPORTED_SONAME_${config}")
            if(NOT soname OR soname MATCHES "-NOTFOUND$")
                set(soname "${path}")
            endif()
            get_filename_component(name "${soname}" NAME)
            set(${out_path} "${path}" PARENT_SCOPE)
            set(${out_name} "${name}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    get_target_property(path "${target}" IMPORTED_LOCATION)
    if(path AND EXISTS "${path}")
        get_filename_component(name "${path}" NAME)
        set(${out_path} "${path}" PARENT_SCOPE)
        set(${out_name} "${name}" PARENT_SCOPE)
    endif()
endfunction()

function(iisociety_check_provider_qt_dependency_text expected_name dependencies)
    string(REGEX MATCHALL "libiiFileProvider\\.[0-9]+(\\.[0-9]+)*\\.dylib" names "${dependencies}")
    foreach(name IN LISTS names)
        if(NOT name STREQUAL expected_name)
            message(FATAL_ERROR
                "A dependent library references an incompatible iiFileProvider Qt ABI: "
                "${name}; selected ${expected_name}. Rebuild it with the selected provider.")
        endif()
    endforeach()
endfunction()

function(iisociety_check_provider_runtime_collision)
    if(CMAKE_CONFIGURATION_TYPES)
        set(configurations ${CMAKE_CONFIGURATION_TYPES})
    elseif(CMAKE_BUILD_TYPE)
        set(configurations "${CMAKE_BUILD_TYPE}")
    else()
        set(configurations NOCONFIG)
    endif()
    foreach(configuration IN LISTS configurations)
        iisociety_imported_runtime(iiFileProvider::Native "${configuration}" selected runtime_name)
        if(NOT selected OR NOT runtime_name)
            continue()
        endif()
        iisociety_imported_runtime(iiFileProvider::iiFileProvider "${configuration}" qt_selected qt_name)
        foreach(dependency IN LISTS ARGN)
            iisociety_imported_runtime("${dependency}" "${configuration}" binary ignored_name)
            if(binary)
                get_filename_component(directory "${binary}" DIRECTORY)
                iisociety_check_provider_binary_files("${selected}" "${directory}/${runtime_name}")
                if(qt_selected AND qt_name)
                    iisociety_check_provider_binary_files("${qt_selected}" "${directory}/${qt_name}")
                    if(APPLE AND CMAKE_HOST_APPLE AND NOT CMAKE_CROSSCOMPILING)
                        find_program(_iisociety_otool NAMES otool REQUIRED)
                        execute_process(COMMAND "${_iisociety_otool}" -L "${binary}"
                            RESULT_VARIABLE result OUTPUT_VARIABLE dependencies ERROR_VARIABLE error)
                        if(NOT result EQUAL 0)
                            message(FATAL_ERROR "Cannot inspect ${binary}: ${error}")
                        endif()
                        iisociety_check_provider_qt_dependency_text("${qt_name}" "${dependencies}")
                    endif()
                endif()
            endif()
        endforeach()
    endforeach()
endfunction()

function(iisociety_check_provider_targets)
    get_target_property(native_includes iiFileProvider::Native INTERFACE_INCLUDE_DIRECTORIES)
    get_target_property(qt_includes iiFileProvider::iiFileProvider INTERFACE_INCLUDE_DIRECTORIES)
    foreach(native_dir IN LISTS native_includes)
        foreach(qt_dir IN LISTS qt_includes)
            if(IS_ABSOLUTE "${native_dir}" AND IS_ABSOLUTE "${qt_dir}")
                iisociety_check_provider_header_files(
                    "${native_dir}/iiFileProviderDevice.h" "${qt_dir}/iiFileProviderDevice.h")
            endif()
        endforeach()
    endforeach()
endfunction()
